<%# (NFG-3714) Rendered for a GET to the auth path. omniauth 2 only starts the request phase on a
    POST carrying an authenticity token, so this page immediately POSTs itself to the same path.
    Standalone HTML (no host layout, no host assets) so it works in every consuming app. %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Signing in</title>
  <style>
    body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
           font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; color: #333; }
    .sso-openid-continue { text-align: center; }
    .sso-openid-continue input[type="submit"] { font-size: 1rem; padding: 0.6em 1.4em; cursor: pointer; }
  </style>
</head>
<body>
  <div class="sso-openid-continue">
    <%= form_tag @sso_openid_request_url, method: :post, id: "sso-openid-request-form" do %>
      <p>Redirecting you to sign in&hellip;</p>
      <noscript><p>JavaScript is disabled, so use the button to continue.</p></noscript>
      <%= submit_tag "Continue to sign in", name: nil, data: { disable_with: false } %>
    <% end %>
  </div>
  <%= javascript_tag nonce: true do %>
    document.getElementById("sso-openid-request-form").submit();
  <% end %>
</body>
</html>
